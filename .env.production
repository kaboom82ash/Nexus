# Google OAuth Client ID for the deployed (GitHub Pages) build.
#
# A browser OAuth client id is NOT a secret — Google publishes it in page
# source by design, and the security control is the "Authorized JavaScript
# origins" allowlist on the client itself, which limits it to this site.
# So it lives in the repo rather than in a CI secret, and the deployed site
# works without any per-browser setup.
#
# Requires on the Google Cloud client:
#   Authorized JavaScript origins -> https://kaboom82ash.github.io
#   APIs enabled -> Gmail API, Google Calendar API
#   Scopes -> gmail.readonly, calendar.readonly
VITE_GOOGLE_CLIENT_ID=180438832758-3b6tmeuh2et6hnvrpihhdlahisd3009t.apps.googleusercontent.com
